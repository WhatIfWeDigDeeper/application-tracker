{
  "name": "yoga-api",
  "version": "1.0.0",
  "description": "GraphQL Yoga API for Application Tracker with Pothos, Prisma and Postgres",
  "main": "dist/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@pothos/core": "4.12.0",
    "@pothos/plugin-prisma": "4.14.2",
    "@prisma/adapter-pg": "7.4.2",
    "@prisma/client": "7.4.2",
    "busboy": "1.6.0",
    "dotenv": "16.5.0",
    "graphql": "16.13.1",
    "graphql-yoga": "5.18.1",
    "pg": "8.20.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/node": "25.4.0",
    "@types/pg": "8.11.14",
    "@typescript-eslint/eslint-plugin": "8.57.0",
    "@typescript-eslint/parser": "8.57.0",
    "eslint": "10.0.3",
    "prisma": "7.4.2",
    "tsx": "4.19.3",
    "typescript": "5.9.3",
    "vitest": "3.1.1",
    "vitest-mock-extended": "2.0.2"
  },
  "overrides": {
    "hono": ">=4.12.4",
    "@hono/node-server": ">=1.19.10",
    "lodash": "4.17.23",
    "chevrotain": ">=11.0.0"
