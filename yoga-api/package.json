{
  "name": "yoga-api",
  "version": "1.0.0",
  "description": "GraphQL Yoga API for Application Tracker with Pothos, Prisma and Postgres",
  "main": "dist/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@pothos/core": "4.3.0",
    "@pothos/plugin-prisma": "4.6.0",
    "@prisma/client": "6.6.0",
    "busboy": "1.6.0",
    "dotenv": "16.5.0",
    "graphql": "16.10.0",
    "graphql-yoga": "5.13.4",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/node": "22.14.0",
    "@typescript-eslint/eslint-plugin": "8.29.1",
    "@typescript-eslint/parser": "8.29.1",
    "eslint": "9.23.0",
    "prisma": "6.6.0",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vitest": "3.1.1",
    "vitest-mock-extended": "2.0.2"
  }
