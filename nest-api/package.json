{
  "name": "nest-api",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@fastify/multipart": "9.4.0",
    "@bufbuild/protobuf": "2.11.0",
    "@grpc/grpc-js": "1.13.4",
    "@nestjs/common": "11.1.19",
    "@nestjs/core": "11.1.19",
    "@nestjs/microservices": "11.1.19",
    "@nestjs/platform-fastify": "11.1.19",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "papaparse": "5.5.3",
    "postgres": "3.4.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "11.0.17",
    "@nestjs/testing": "11.1.19",
    "@types/node": "25.3.5",
    "@types/papaparse": "5.5.2",
    "drizzle-kit": "0.31.9",
    "eslint": "10.0.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "4.0.18"
  },
  "overrides": {
    "path-to-regexp": "8.4.2",
    "picomatch": "4.0.4",
    "vite": "7.3.2",
    "fastify": "5.8.5",
    "fast-uri": "3.1.2"
  }
}
