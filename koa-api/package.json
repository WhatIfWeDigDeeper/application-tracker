{
  "name": "koa-pg-api",
  "version": "1.0.0",
  "description": "Koa API for Job Application Tracker with raw pg",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "format": "prettier --write src",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "15.3.2",
    "dotenv": "^17.3.1",
    "koa": "3.1.2",
    "koa-bodyparser": "^4.4.1",
    "pg": "8.19.0",
    "uuid": "^14.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/koa": "^3.0.1",
    "@types/koa__cors": "5.0.1",
    "@types/koa__router": "12.0.5",
    "@types/koa-bodyparser": "4.3.13",
    "@types/node": "25.3.5",
    "@types/pg": "8.18.0",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "eslint": "10.0.3",
    "jest": "^30.2.0",
    "prettier": "3.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1"
  },
  "overrides": {
    "is-generator-function": "1.0.10"
  }
}
