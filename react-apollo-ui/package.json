    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@apollo/client": "3.13.4",
    "@tanstack/react-router": "1.114.23",
    "graphql": "16.10.0",
