{
  "name": "react-apollo-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3080",
    "build": "tsc -p tsconfig.node.json --noEmit && tsc --noEmit && vite build",
