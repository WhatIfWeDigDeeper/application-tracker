{
  "name": "job-tracker-lambda-api",
  "version": "1.0.0",
  "description": "Job Application Tracker API with Hono, AWS Lambda, and DynamoDB",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "lint": "eslint src",
    "test": "vitest run",
    "start": "node dist/server.js",
    "setup": "tsx scripts/setup-dynamodb.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1024.0",
    "@aws-sdk/lib-dynamodb": "3.1024.0",
    "@hono/node-server": "2.0.0",
    "@hono/zod-validator": "0.7.6",
    "dotenv": "17.4.0",
    "hono": "4.12.15",
    "uuid": "14.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.3.5",
    "@types/uuid": "11.0.0",
    "eslint": "10.0.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vitest": "4.1.2"
  },
  "overrides": {
    "vite": "7.3.2"
  }
}
