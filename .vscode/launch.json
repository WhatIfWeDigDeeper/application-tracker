{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Express API (port 5000)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/api/node_modules/.bin/tsx",
      "args": [
        "src/index.ts"
      ],
      "cwd": "${workspaceFolder}/api",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Koa API (port 5010)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/koa-api/node_modules/.bin/tsx",
      "args": [
        "src/index.ts"
      ],
      "cwd": "${workspaceFolder}/koa-api",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Hono API (port 5030)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/hono-api/node_modules/.bin/tsx",
      "args": [
        "src/index.ts"
      ],
      "cwd": "${workspaceFolder}/hono-api",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Nuxt API (port 5040)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "${workspaceFolder}/nuxt-api",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "NestJS API (port 5050)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/nest-api/node_modules/.bin/tsx",
      "args": [
        "src/main.ts"
      ],
      "cwd": "${workspaceFolder}/nest-api",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "FastAPI (port 5160)",
      "type": "debugpy",
      "request": "launch",
      "module": "src",
      "cwd": "${workspaceFolder}/fastapi",
      "jinja": true,
      "envFile": "${workspaceFolder}/fastapi/.env",
      "env": {
        "FASTAPI_RELOAD": "false"
      },
      "postDebugTask": "cleanup-tanstack-fastapi"
    },
    {
      "name": "Go Gin API (port 5070)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/go-api/cmd/server",
      "envFile": "${workspaceFolder}/go-api/.env"
    },
    {
      "name": "Java Spring API (Attach)",
      "type": "java",
      "request": "attach",
      "hostName": "localhost",
      "port": 5005
    },
    {
      "type": "node",
      "request": "launch",
      "name": "yoga-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "${workspaceFolder}/yoga-api",
      "env": {
        "NODE_ENV": "development"
      },
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "editor-browser",
      "request": "launch",
      "name": "Tanstack Start UI (port 3040)",
      "url": "http://localhost:3040",
      "webRoot": "${workspaceFolder}/tanstack-start-ui",
      "preLaunchTask": "start-tanstack-start-ui-when-fastapi-ready",
      "postDebugTask": "cleanup-tanstack-fastapi"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Lambda React UI (port 3090)",
      "url": "http://localhost:3090",
      "webRoot": "${workspaceFolder}/lambda-react-ui"
    }
  ],
  "compounds": [
    {
      "name": "Tanstack Start + FastAPI (Debug)",
      "configurations": [
        "FastAPI (port 5160)",
        "Tanstack Start UI (port 3040)"
      ],
      "stopAll": true
    }
  ]
}
