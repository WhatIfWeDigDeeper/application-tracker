{
  "name": "application-tracker-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Application Tracker - Monorepo root",
  "scripts": {
    "audit:ci:api": "cd api && npm_config_yes=true npx audit-ci --config .auditconfig.json",
    "audit:ci:ui": "cd ui && npm_config_yes=true npx audit-ci --config .auditconfig.json",
    "audit:ci": "npm run audit:ci:api && npm run audit:ci:ui",
    "dev:api": "cd api && npm run dev",
    "dev:ui": "cd ui && npm run dev",
    "dev": "npm run dev:api & npm run dev:ui",
    "build:api": "cd api && npm run build",
    "build:ui": "cd ui && npm run build",
    "build": "npm run build:api && npm run build:ui",
    "lint:api": "cd api && npm run lint",
    "lint:ui": "cd ui && npm run lint",
    "lint": "npm run lint:api && npm run lint:ui",
    "ci:api": "cd api && npm ci",
    "ci:ui": "cd ui && npm ci",
    "ci:all": "npm ci && npm run ci:api && npm run ci:ui",
    "prisma:generate": "cd api && npm run prisma:generate",
    "prisma:migrate:dev": "cd api && npm run prisma:migrate:dev",
    "prisma:studio": "cd api && npm run prisma:studio",
    "seed": "cd api && npm run seed",
    "test:api": "cd api && npm test",
    "test:ui": "cd ui && npm test",
    "test": "npm run test:api && npm run test:ui",
    "test:coverage": "npm run test:api -- --coverage && npm run test:ui -- --coverage",
    "test:api:opaque": "npm_config_yes=true npx jest --config tests/jest.config.js --testPathPatterns=tests/api",
    "test:e2e": "npm_config_yes=true npx playwright test",
    "test:e2e:ui": "npm_config_yes=true npx playwright test --ui",
    "test:e2e:debug": "npm_config_yes=true npx playwright test --debug",
    "clean": "rm -rf node_modules api/node_modules ui/node_modules api/dist ui/.next",
    "kill:all-next-dev": "pkill -f \"next dev\""
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.9",
    "typescript": "^5.9.3"
  }
}
