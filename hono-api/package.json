{
  "name": "job-tracker-hono-api",
  "version": "1.0.0",
  "description": "Job Application Tracker API with Hono and Drizzle",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "lint": "eslint src",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
