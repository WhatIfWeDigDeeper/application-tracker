    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "hono": "4.12.12",
    "postgres": "3.4.8",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "25.3.5",
    "drizzle-kit": "^0.31.9",
    "eslint": "10.0.3",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1"
  },
  "overrides": {
    "esbuild": "0.27.2"
  }
}
